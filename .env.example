# Environment Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Super Admin Initial Seed Credentials
ADMIN_EMAIL="admin@exambondhubd.com"
ADMIN_PASSWORD="Admin@123456"
ADMIN_NAME="ExamBondhuBD Admin"

# PostgreSQL Database (Supabase or local PostgreSQL)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=public"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=public"

# Redis Cache & Queue
REDIS_URL="redis://localhost:6379"

# Supabase Auth & Keys
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-publishable-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-secret-service-role-key"

# JSON Web Token Secret
JWT_SECRET="generate-a-secure-256-bit-secret-here"
JWT_EXPIRES_IN="7d"

# Comma-separated browser origins allowed to call this API directly (the
# dashboard's own browser no longer needs to be listed — it now goes through
# its own Next.js server, which isn't subject to CORS). Add the real
# dashboard domain here once one exists.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# SMTP — sends the email-verification code students get at registration.
# Gmail: host smtp.gmail.com, port 587, user your address, password a 16-char
# "App Password" (myaccount.google.com/apppasswords, needs 2-Step Verification).
# Or use a transactional provider such as Brevo's free tier.
# Leave SMTP_USER / SMTP_PASSWORD blank to run without email — codes are then
# printed to the server log instead of sent.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-smtp-username"
SMTP_PASSWORD="your-smtp-password-or-app-password"
MAIL_FROM_NAME="ExamBondhuBD"
MAIL_FROM_EMAIL="no-reply@yourdomain.com"
